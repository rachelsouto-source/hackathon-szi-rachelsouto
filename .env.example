# ===== Auditor de DD Técnica v2 — variáveis de ambiente =====
#
# Confira o que está ligado em /api/health — ele diz exatamente o que falta.
# O painel mostra um aviso vermelho enquanto faltar algo essencial.

# ---------------------------------------------------------------------------
# ESSENCIAIS — sem os dois o app roda em DEMO e exibe exemplos fixos do repo
# ---------------------------------------------------------------------------

# Deixe VAZIO em produção. Com "1", força o modo demo mesmo com credenciais.
DEMO_MODE=

ANTHROPIC_API_KEY=

# Service Account do Google. Cole o JSON INTEIRO nesta variável (recomendado no Coolify).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativa: caminho de um .json montado no container.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Pasta que LISTA os empreendimentos ("00 - Empreendimentos Estruturados / em Estruturação").
# Precisa estar COMPARTILHADA (leitor) com o e-mail da service account.
EMPREENDIMENTOS_FOLDER_ID=1D9y8aKfkGGE13WbGMlw07G8Euu0Pg7fF

# ---------------------------------------------------------------------------
# MEMÓRIA — o app funciona sem, mas perde justamente o que a revisão pediu
# ---------------------------------------------------------------------------

# Diário de Lançamentos (seazone-tech/diario-lancamentos).
# Opção A: clone local montado no container.
DIARIO_REPO_DIR=/data/diario-lancamentos
# Opção B: token do GitHub com leitura no repo (usado se DIARIO_REPO_DIR não existir).
GITHUB_TOKEN=

# Base histórica de DD Técnica — planilha do repo do Vini
# ("Base de Conhecimento — DD Técnica (Seazone)"). Compartilhar em LEITURA com a
# service account. Sem isto não há comparação com casos anteriores.
BASE_SHEET_ID=

# Coordenadas por empreendimento, para o critério de PROXIMIDADE GEOGRÁFICA
# ("tenho o Patacho que está a x km"). Formato: "emp_id:lat,lon;emp_id:lat,lon".
# Provisório: a base histórica ainda não tem coluna de coordenadas.
AUDITOR_COORDS=

# Volume gravável: histórico entre rodadas, cache de extração e contestações.
# Sem volume, tudo vira memória e some no restart.
AUDITOR_DADOS_DIR=/data/auditor

# ---------------------------------------------------------------------------
# MODELOS E LIMITES
# ---------------------------------------------------------------------------

ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_LEVE=claude-sonnet-5

# Iterações do loop investigativo (leituras + consultas por auditoria).
DD_MAX_ITERACOES=40
# Tokens por passo de investigação e da consolidação final do parecer.
DD_MAX_TOKENS_INV=8000
DD_MAX_TOKENS=32000
# Auditorias simultâneas.
DD_WORKERS=2

# Porta (Coolify costuma injetar)
PORT=8000
